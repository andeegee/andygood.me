# Keep false until approved content and metadata are ready for public launch.
# Vercel preview builds remain noindex even when this is true.
SITE_INDEXABLE=false

# Internal content briefing. Disabled until provider configuration is ready.
CONTENT_BRIEFING_ENABLED=false
# Server-only credentials for an OpenAI-compatible Chat Completions provider.
CONTENT_BRIEFING_API_KEY=
# Required: a model supporting strict JSON Schema structured outputs.
CONTENT_BRIEFING_MODEL=
# Optional. Defaults to https://api.openai.com/v1. HTTPS required in production.
CONTENT_BRIEFING_BASE_URL=https://api.openai.com/v1

# Public Website Friction Scan. Enable only after the setup in docs/website-friction-scan.md.
FRICTION_SCAN_ENABLED=false
# Optional separate model credentials. Blank values reuse CONTENT_BRIEFING_*.
FRICTION_SCAN_API_KEY=
FRICTION_SCAN_MODEL=
FRICTION_SCAN_BASE_URL=
# Required: 32 random bytes encoded as 64 hexadecimal characters. Server-only.
FRICTION_SCAN_TOKEN_SECRET=
# Upstash Redis REST endpoint and token. Only expiring counters/hashed identifiers are stored.
FRICTION_SCAN_REDIS_URL=
FRICTION_SCAN_REDIS_TOKEN=
# Resend transactional email. Verify the sending domain first.
RESEND_API_KEY=
FRICTION_SCAN_FROM_EMAIL=
FRICTION_SCAN_LEAD_EMAIL=
